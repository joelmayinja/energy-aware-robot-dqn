# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyc

# Virtual environments
venv/
env/
.venv/
.venv*/
.conda-training/

# Jupyter
.ipynb_checkpoints/

# Data (datasets can be large — don't commit raw data to git)
data/raw/*
!data/raw/.gitkeep
!data/raw/steel/
!data/raw/collaborative_robot/
!data/raw/high_payload_robot/
data/raw/*/*
!data/raw/*/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/simulated/*
!data/simulated/.gitkeep

# Trained model weights (can be large too)
models/*.pt
models/*.pth
models/*.onnx
!models/.gitkeep

# OS junk
.DS_Store
Thumbs.db

# Editor settings
.vscode/
.idea/

# Logs
*.log
training_history.csv

# Local workspace and generated validation artifacts
/.kilo/
/colab_source/
/tmp/
